# Lattice files and generated study data.
# Lattices live outside this repo (see README: ../acc-models-fcc-ee) and
# generated ones run to 100s of MB. Use `git add -f <file>` for the rare
# small JSON that genuinely belongs in version control.
*.json
*.h5
*.npz
*.parquet

# Outputs
outputs/
results/
figures/
*.png
*.pdf

# Notebooks
.ipynb_checkpoints/
*_old.ipynb

# Python
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.eggs/

# Test & tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/
.conda/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Generated checkpoint data. The lattices are .json.gz, so the *.json rule
# above does not catch them.
checkpoints/

# Local scratch, deliberately kept out of the shared history.
notebooks/
tests/
trim_position_scan.py
tapering_granularity_scenario2_trim_position_comparison.ipynb

# Symlink to the tracked top-level tapering.py; committing it would give the
# repo a second copy of the same module.
src/tapering.py
